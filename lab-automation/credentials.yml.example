---
# LM AIOps Demo — Credentials Template
#
# Copy and fill in your values:
#   cp lab-automation/credentials.yml.example lab-automation/credentials.yml
#
# Basic bootstrap (credential types + job templates only):
#   ansible-playbook lab-automation/aap_bootstrap_lm_aiops.yml \
#     -e @lab-automation/credentials.yml
#
# Full bootstrap (also creates credentials, Event Stream, workflow template):
#   ansible-playbook lab-automation/aap_bootstrap_lm_aiops.yml \
#     -e @lab-automation/credentials.yml \
#     -e full_bootstrap=true

# Optional if CONTROLLER_HOST / CONTROLLER_USERNAME / CONTROLLER_PASSWORD
# are already exported. Extra vars override env.
controller_host: "https://aap.example.com"
controller_username: "admin"
controller_password: "CHANGEME"
# Defaults to true (CONTROLLER_VERIFY_SSL). Set false for lab Controllers
# with self-signed certificates.
# controller_verify_ssl: false

# Git URL of this repository (Controller + EDA projects). Required.
lm_aiops_project_url: "https://github.com/example/logicmonitor-aap-aiops.git"
# lm_aiops_project_branch: main

# SSH to ContainerLab EOS. Password is required; do not commit the real value.
workshop_ssh_user: admin
workshop_ssh_password: CHANGEME

# Must already exist on the Controller. Override if your EE has another name.
# lm_aiops_ee: "Default execution environment"

# --- LogicMonitor API (required when full_bootstrap=true) ---
lm_company: "yourcompany"
lm_bearer_token: "CHANGEME"

# --- Edwin AI (required when full_bootstrap=true) ---
edwin_portal: "yourportal"
edwin_access_id: "CHANGEME"
edwin_access_key: "CHANGEME"

# --- EDA Event Stream (required when full_bootstrap=true) ---
# token (default): live LM Custom HTTP static header. hmac: validation/test_*.sh.
eda_event_stream_auth: token
eda_event_stream_token: "CHANGEME"
# eda_event_stream_header: Authorization
# eda_event_stream_auth: hmac
# eda_hmac_secret: "CHANGEME"
# Existing EDA Controller token that can launch AAP job templates.
eda_controller_token_name: "CHANGEME"
# Must already exist on EDA. Override if the name differs.
# eda_decision_environment: "Default Decision Environment"
